{
  "manifest_version": 3,
  "name": "PhishGuard AI The Real-Time Phishing Detector",
  "version": "1.0.0",
  "description": "AI-powered phishing detection. Scans every site you visit, analyses URL/SSL/content with ML, warns you before you get hooked.",
  "key": "",
  "permissions": ["activeTab", "tabs", "storage", "notifications", "alarms", "identity"],
  "host_permissions": ["<all_urls>", "https://gmail.googleapis.com/*"],
  "externally_connectable": {
    "matches": ["http://localhost:5000/*", "http://127.0.0.1:5000/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PhishGuard AI"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
